+    per_group: dict[int, list[tuple[tuple[int, int], dict, int, int, int]]] = {}
+    for page_index, page in enumerate(spec["pages"]):
+        for band_index, band in enumerate(page["bands"]):
+            if band["kind"] == "total":
+                continue
+            rows = group_rows_for(band)
+            if rows is None:
+                continue
+            start, reach = _band_span(band)
+            per_group.setdefault(id(rows), []).append(
+                ((page_index, band_index), band, start, reach, len(rows))
+            )
+
+    for members in per_group.values():
+        data_len = members[0][4]
