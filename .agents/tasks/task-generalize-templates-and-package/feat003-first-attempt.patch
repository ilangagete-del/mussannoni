+def _band_span(band: dict) -> tuple[int, int]:
+    """The band's (first data index, rows-consumed) into its group.
+
+    Reads the recovered ``row_data_index`` (which already honours the band's
+    ``group_offset`` and any chrome gaps), so the span is exactly what the
+    reference band consumed — the value that keeps the band inert on
+    reference-length data. ``start`` is the first data row the band shows and
+    ``reach`` is the count of data rows it covers (its highest index minus its
+    lowest, inclusive).
+    """
+    reference = band["reference_rows"]
+    indices = [_data_index(band, row) for row in range(reference)]
+    real = [i for i in indices if i is not None]
+    if not real:
