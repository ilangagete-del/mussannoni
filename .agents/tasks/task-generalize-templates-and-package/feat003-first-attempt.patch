+        tail = max(range(len(members)), key=lambda i: members[i][2] + members[i][3])
+        for position, (pos, band, start, reach, _dl) in enumerate(members):
+            reference = band["reference_rows"]
+            if start >= data_len and reach > 0:
+                # This band's rows are entirely past the supplied data.
+                overrides[pos] = 0
+                continue
+            if position == tail and reach > 0:
+                covered = start + reach  # rows the reference reached in the group
+                if data_len > covered:
+                    # Longer data: the tail absorbs every remaining row, keeping
+                    # at least its reference shape (its own chrome / gaps).
+                    overrides[pos] = max(reference, reference + (data_len - covered))
+    return overrides
