+#: Vertical breathing room around a clipped run, so clipping never shaves a
+#: glyph's ascender/descender — only its horizontal overflow past the cell.
+_CLIP_VPAD = 4.0
+
+
+def _clip_box(cell: dict, cell_box: Box, text: str, canvas: Canvas) -> Box | None:
+    """A clip rectangle for an OVER-WIDE value, else ``None`` (no clipping).
+
+    Clipping is applied only when the measured run is wider than the cell box —
+    a value that fits is emitted byte-for-byte as before, so the reference rows
+    (which fit their columns) are wholly unaffected. Over-wide values are cut at
+    the cell's own edge the way the reference clips them, instead of overhanging
+    the next column or running off the page. The clip is horizontal only: the
+    box is grown vertically so a tall glyph is never shaved.
+    """
+    align = cell.get("align", "center")
+    if align == "center":
+        # A centred value that overflows spills equally both sides; clipping it
+        # to the narrow cell box would hide its middle. These columns are the
+        # fixed-width code/count columns whose values never overflow in practice,
+        # so leave centred cells unclipped (still inert, and no worse than today).
+        return None
+    width = canvas.measure(text.strip(), cell["role"], cell["size"])
+    pad = float(cell.get("pad", 0.0))
+    if width <= cell_box.w - pad + 0.5:
+        return None
+    return Box(cell_box.x, cell_box.y - _CLIP_VPAD, cell_box.w, cell_box.h + 2 * _CLIP_VPAD)
