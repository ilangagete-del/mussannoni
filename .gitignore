# Extracted from the committed sars.zip by `sars unpack`; 25 MB of duplicate
# bytes, so it is rebuilt rather than stored. Anchored with a leading slash so it
# matches only the top-level directory: an unanchored `data/` also matches
# `output/data/`, which silently excluded the extracted report JSON.
/data/

# NOTE: output/ is intentionally committed so the converted HTML+CSS, the A4
# PDFs and the reference/output comparison images can be reviewed directly on
# GitHub without running the pipeline. Regenerate with `sars all`.

# python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Font assets are DERIVED from the reference PDFs by tools/build_fonts.py (they
# are the real Arial / Times / Arial Narrow / Calibri faces those documents
# embed, plus URW Nimbus for the ones they only name).
#
# They ARE committed, and they ship inside the package at
# src/sars/assets/fonts/. This is a deliberate decision, recorded in
# docs/PACKAGING.md: the project permits no fallback font, so a renderer without
# these faces does not degrade - it is wrong. Shipping them is what makes
# `pip install sars-convert` sufficient to reproduce a report. The licensing
# position and how to build a faces-free distribution instead are both written
# down in docs/PACKAGING.md.
#
# The rasterised calibration cache is derived, not source.
/src/sars/assets/fonts/calibration.json

# Diagnostic output: the oracle replay, the engine bake-off renders and scratch
# measurements are measuring instruments, not deliverables.
/output/replay_html/
/output/replay_pdf/
/output/engine_bakeoff/
/output/scratch/

# Scratch comparison/measurement dirs written by ad-hoc diagnostic runs.
/.tmp_all/
/.tmp_cmp/
/.tmp_cmp2/

# Experimental renders at the data extremes (tools/stress_data.py). Fixtures are
# reproducible from the tool, so the renders themselves are not deliverables.
/output/stress/

# Build artefacts from `uv build` / `python -m build`.
/dist/
/build/
